{
  "name": "dvenadcat-shagov",
  "version": "1.0.0",
  "private": true,
  "description": "Офлайн-приложение для работы по 12 шагам с материалами исследования",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "research": "node scripts/build-research.mjs",
    "icons": "python3 scripts/make_icons.py",
    "sync": "npm run content:steps && npm run research && cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "content:steps": "npm run vendor:imports && node scripts/build-step-content.cjs",
    "preserve": "npm run content:steps",
    "test:step": "node --test tests/*.test.cjs",
    "vendor:imports": "node scripts/vendor-importers.cjs",
    "bundle:step01": "node scripts/build-personal-step-bundle.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "fflate": "0.8.3",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "marked": "^18.1.2"
  }
}
