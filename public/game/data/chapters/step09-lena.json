      "lines": [
        {
          "id": "s9-lena.end.0",
          "speaker": "n",
          "text": "Степаныч ставит карандашом маленькую стрелку у строки. Никто никуда не идёт."
        }
      ]
    },
    "s9-lena-direct": {
      "type": "story",
      "title": "Три дороги",
      "lines": [
        {
          "id": "s9-lena.direct.0",
          "speaker": "stepan",
          "text": "Можно. Без речей, без оправданий. Сначала с суммой и сроком, которые ты правда потянешь."
        }
      ],
      "next": "s9-lena-after"
