            },
            {
              "id": "s9-lena.harm.1.none",
              "text": "Сейчас риска здесь не вижу или не знаю"
            }
          ]
        },
        {
          "id": "s9-lena.harm.2",
          "title": "Другим людям",
          "options": [
            {
              "id": "s9-lena.harm.2.risk",
              "text": "Вижу риск: тимка услышит взрослый разговор, не предназначенный ему."
            },
            {
              "id": "s9-lena.harm.2.none",
              "text": "Сейчас риска здесь не вижу или не знаю"
            }
          ]
        },
        {
          "id": "s9-lena.harm.3",
          "title": "Хватит ли сил",
          "options": [
            {
              "id": "s9-lena.harm.3.risk",
              "text": "Сейчас сил может не хватить"
