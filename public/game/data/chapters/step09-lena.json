            "s9-lena.harm.0.risk",
            "s9-lena.harm.1.risk",
            "s9-lena.harm.2.risk",
            "s9-lena.harm.3.risk"
          ]
        },
        {
          "id": "s9-lena.road.1",
          "speaker": "stepan",
          "text": "Ну что, какую дорогу пока рисуем? Это черновик, не обещание."
        }
      ],
      "choice": {
        "id": "s9-lena.route",
        "prompt": "Какая дорога",
        "options": [
          {
            "id": "s9-lena.route.direct",
            "label": "Прямо: сказать и исправить самому",
            "next": "s9-lena-direct"
